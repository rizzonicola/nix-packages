+        # single-instance lock under the XDG configuration directory instead
+        # of next to the Python sources.
+        app_dir = os.path.join(
+            os.environ.get("XDG_CONFIG_HOME") or get_user_home_directory() + "/.config",
+            "clipcascade",
+        )
+        os.makedirs(app_dir, exist_ok=True)
+        return app_dir
